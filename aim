local Players, UIS, RS = game:GetService("Players"), game:GetService("UserInputService"), game:GetService("RunService")
local plr = Players.LocalPlayer
local MIN, MAX, IMG = 16, 100, "rbxassetid://0" -- thay 0 bằng ID hình của bạn
local speed, invis, fly, orig = MIN, false, false, {}
local WHITE, ON, OFF = Color3.new(1, 1, 1), Color3.fromRGB(60, 150, 90), Color3.fromRGB(60, 60, 80)

local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end
local function round(o, scale, off) new("UICorner", {CornerRadius = UDim.new(scale, off)}, o) end
local function hum() local c = plr.Character return c and c:FindFirstChildOfClass("Humanoid") end

local function applySpeed()
	local h = hum()
	if h then h.WalkSpeed = speed end
end

local function applyInvis()
	local c = plr.Character
	if not c then return end
	for _, d in ipairs(c:GetDescendants()) do
		if (d:IsA("BasePart") and d.Name ~= "HumanoidRootPart") or d:IsA("Decal") then
			orig[d] = orig[d] or d.Transparency
			d.Transparency = invis and 1 or orig[d]
		end
	end
end

plr.CharacterAdded:Connect(function()
	orig = {}
	task.wait(0.5)
	applySpeed()
	applyInvis()
end)

-- Bay: Space = lên, Ctrl trái = xuống
RS.Heartbeat:Connect(function()
	if not fly then return end
	local h, r = hum(), plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
	if not (h and r) then return end
	h.PlatformStand = true
	local up = (UIS:IsKeyDown(Enum.KeyCode.Space) and 1 or 0) - (UIS:IsKeyDown(Enum.KeyCode.LeftControl) and 1 or 0)
	local m = h.MoveDirection
	r.AssemblyLinearVelocity = Vector3.new(m.X, up, m.Z) * speed
end)

