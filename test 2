	TextColor3 = WHITE, TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBold, TextSize = 18}, menu)

local closeBtn = new("TextButton", {Size = UDim2.new(0, 28, 0, 28), Position = UDim2.new(1, -34, 0, 6), BackgroundColor3 = Color3.fromRGB(200, 60, 60),
	Text = "✕", TextColor3 = WHITE, Font = Enum.Font.GothamBold, TextSize = 14}, menu)
round(closeBtn, 0, 8)

