	Text = "Tốc độ: " .. speed, TextColor3 = WHITE, TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.Gotham, TextSize = 16}, menu)

local track = new("Frame", {Size = UDim2.new(1, -30, 0, 8), Position = UDim2.new(0, 15, 0, 82), BackgroundColor3 = Color3.fromRGB(70, 70, 90)}, menu)
round(track, 1, 0)
local knob = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0, 22, 0, 22), Position = UDim2.new(0, 0, 0.5, 0),
	BackgroundColor3 = Color3.fromRGB(90, 170, 255)}, track)
round(knob, 1, 0)

local function toggle(text, y, cb)
	local b = new("TextButton", {Size = UDim2.new(1, -30, 0, 36), Position = UDim2.new(0, 15, 0, y), BackgroundColor3 = OFF,
		Text = text .. ": TẮT", TextColor3 = WHITE, Font = Enum.Font.GothamBold, TextSize = 16}, menu)
	round(b, 0, 8)
	local on = false
	b.MouseButton1Click:Connect(function()
		on = not on
		b.Text = text .. ": " .. (on and "BẬT" or "TẮT")
		b.BackgroundColor3 = on and ON or OFF
		cb(on)
	end)
end

toggle("Tàng hình", 110, function(on) invis = on applyInvis() end)
toggle("Bay", 158, function(on)
	fly = on
	local h = hum()
	if h and not on then h.PlatformStand = false end
end)

-- Khuôn tròn Trinh
local circle = new("ImageButton", {Size = UDim2.new(0, 64, 0, 64), Position = UDim2.new(0, 20, 0.5, -32), BackgroundColor3 = Color3.fromRGB(90, 170, 255),
	Image = IMG, ScaleType = Enum.ScaleType.Crop, Visible = false}, gui)
round(circle, 1, 0)
new("TextLabel", {Size = UDim2.new(1, 0, 0, 18), Position = UDim2.new(0, 0, 1, 2), BackgroundTransparency = 1, Text = "Trinh",
	TextColor3 = WHITE, TextStrokeTransparency = 0.5, Font = Enum.Font.GothamBold, TextSize = 14}, circle)

local function setMenu(open) menu.Visible, circle.Visible = open, not open end
closeBtn.MouseButton1Click:Connect(function() setMenu(false) end)
circle.MouseButton1Click:Connect(function() setMenu(true) end)

-- Thanh trượt tốc độ
local dragging = false
local function isPress(t) return t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch end
local function slide(x)
	local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
	speed = math.floor(MIN + rel * (MAX - MIN))
	knob.Position = UDim2.new(rel, 0, 0.5, 0)
	speedLabel.Text = "Tốc độ: " .. speed
	applySpeed()
end
track.InputBegan:Connect(function(i) if isPress(i.UserInputType) then dragging = true slide(i.Position.X) end end)
UIS.InputChanged:Connect(function(i)
	if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then slide(i.Position.X) end
end)
UIS.InputEnded:Connect(function(i) if isPress(i.UserInputType) then dragging = false end end)

applySpeed()
